# Auto detect text files and perform LF normalization
* text=auto

# Sources and scripts are LF everywhere so the Linux CI runners and a
# Windows checkout always agree
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
tools/hooks/* text eol=lf
